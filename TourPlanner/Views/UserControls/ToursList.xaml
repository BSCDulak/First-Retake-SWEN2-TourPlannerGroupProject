<UserControl x:Class="SWEN2_TourPlannerGroupProject.Views.UserControls.ToursList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SWEN2_TourPlannerGroupProject.Views.UserControls"
             xmlns:viewModels="clr-namespace:SWEN2_TourPlannerGroupProject.ViewModels"
             xmlns:helpers="clr-namespace:SWEN2_TourPlannerGroupProject.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ListView ItemsSource="{Binding Tours}" 
                  SelectedItem="{Binding SelectedTour}" 
                  helpers:SelectedItemsBehavior.SelectedItems="{Binding SelectedTours}" 
                  SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Name}" />
                                <Style.Triggers>
                                    <!-- If Name is empty, show placeholder text -->
                                    <DataTrigger Binding="{Binding Name}" Value="">
                                        <Setter Property="Text" Value="(Unnamed Tour)" />
                                        <Setter Property="Foreground" Value="Gray" />
                                        <Setter Property="FontStyle" Value="Italic" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>
    </Grid>
</UserControl>
